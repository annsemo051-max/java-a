
#include <iostream>
using namespace std;

int main() {
    int arr[6] = {2, 4, 6, 8, 12};
    int num, pos;

    cout << "Enter a new number: ";
    cin >> num;

    cout << "Enter position to insert: ";
    cin >> pos;

    for (int i = 5; i >= pos; i--) {
        arr[i] = arr[i - 1];
    }

    arr[pos - 1] = num;

    cout << "New array: ";

    for (int i = 0; i < 6; i++) {
        cout << arr[i] << " ";
    }

    return 0;
}
